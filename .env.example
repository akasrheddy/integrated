# SecureVote Environment Configuration

# Database Configuration
# (These are automatically set by Replit)
# DATABASE_URL=postgres://username:password@hostname:port/database_name

# Arduino Configuration
# Set to 'false' to use real hardware, 'true' (or any other value) for simulation
ARDUINO_SIMULATION_MODE=false

# Arduino Serial Port (Windows usually uses COM3, COM4, etc. Linux uses /dev/ttyUSB0 or similar)
ARDUINO_PORT=COM11

# Arduino Communication Settings
ARDUINO_BAUD_RATE=9600
ARDUINO_TIMEOUT=5000

# Blockchain Settings
BLOCKCHAIN_PROVIDER_URL=https://mainnet.infura.io/v3/94fd4a8d61d24ba29e2293713893cd59
BLOCKCHAIN_SMART_CONTRACT=0xa7e79f652222042e0daee2709ead2bade79309b3